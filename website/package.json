{
  "name": "the-software-factory-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "dev": "npm run content && node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "npm run content && node scripts/astro.mjs build && node scripts/check-output.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run content && node scripts/astro.mjs check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "cheerio": "1.2.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
