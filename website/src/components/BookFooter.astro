---
import Default from '@astrojs/starlight/components/Footer.astro';
import book from '../data/book.json';
const chapter=book.chapters.find(c=>c.id===Astro.locals.starlightRoute.entry.data.bookId);
---
{chapter && <section class="chapter-finish" data-pagefind-ignore><p>이 장의 판단을 정리하셨나요?</p><button class="primary-button" data-mark-read>읽음으로 표시</button><a data-route-next hidden href="/guide/">추천 경로에서 다음</a><span data-finish-note aria-live="polite"></span></section>}
<Default />
<div class="book-footer" data-pagefind-ignore><a class="roboco-brand" href="https://roboco.io/" aria-label="로보코 홈페이지"><img src="/images/roboco-logo.svg" width="64" height="49" alt="ROBOCO" loading="lazy"/><span>로보코 홈페이지</span></a><a href="/">The Software Factory</a><span>© 2026 정도현</span><a href="/changelog/">체인지 로그</a><a href={book.publication.feedback.url}>책 피드백{book.publication.feedback.access === 'restricted' ? ' (접근 권한 필요)' : ''}</a><a rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">본문 CC BY-SA 4.0</a><a href="/license/#website-code">웹 코드 MIT</a><a href="/license/">라이선스 범위</a><a href="/about/#reading-settings">읽기 설정</a><p data-storage-notice role="status">읽던 위치와 읽음 표시는 이 브라우저에 저장됩니다.</p></div>
<noscript><p>자바스크립트가 꺼져 있습니다. 본문과 목차는 읽을 수 있으며, 추천과 진도 저장은 자바스크립트를 켜면 사용할 수 있습니다.</p></noscript>
<script src="../scripts/reader.ts"></script>
