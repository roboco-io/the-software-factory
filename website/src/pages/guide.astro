---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {purposeLabels,roleLabels,depthLabels} from '../lib/recommendations.mjs';
const questions=[{key:'purpose',title:'지금 해결하려는 문제는 무엇인가요?',hint:'가장 먼저 판단하고 싶은 문제 하나를 선택하세요.',options:purposeLabels},{key:'role',title:'어떤 역할에서 이 문제를 보고 있나요?',hint:'같은 경로에서도 역할에 따라 특히 살펴볼 장을 짚어드립니다.',options:roleLabels},{key:'depth',title:'어느 깊이로 읽고 싶나요?',hint:'핵심 판단부터 살펴보거나 본문으로 바로 들어갈 수 있습니다.',options:depthLabels}];
---
<StarlightPage frontmatter={{title:'나에게 필요한 장 찾기',description:'세 가지 질문으로 찾는 독서 경로',template:'splash',tableOfContents:false,prev:false,next:false,pagefind:false}}>
 <div class="guide-shell" data-guide><p class="page-intro">지금의 질문에서 시작하세요.<br/>세 가지 답변으로 먼저 읽을 장을 골라드립니다.</p>
 <form id="reader-quiz"><p class="quiz-position" data-quiz-position>질문 1 / 3</p>
 {questions.map((q,i)=><fieldset data-step={i} hidden={i!==0}><legend tabindex="-1">{q.title}</legend><p>{q.hint}</p><div class="quiz-options">{Object.entries(q.options).map(([value,label])=><label><input type="radio" name={q.key} value={value}/><span>{label}{value==='intro'&&<small>처음이거나 아직 잘 모르겠어요</small>}</span></label>)}</div></fieldset>)}
 <p class="quiz-error" data-quiz-error role="alert"></p><div class="quiz-actions"><button type="button" class="quiet-button" data-quiz-back hidden>이전 질문</button><button type="submit" class="primary-button" data-quiz-next>다음 질문</button><a href="/contents/">건너뛰고 전체 목차 보기</a></div>
 </form>
 <section id="recommendation-result" hidden aria-labelledby="recommendation-title"><p>당신을 위한 독서 경로</p><h2 id="recommendation-title" tabindex="-1"></h2><p data-route-description></p><p data-role-description></p><div class="route-progress"><span data-route-progress></span><a data-route-continue class="primary-button" href="/contents/">다음 읽을 장</a></div><ol data-recommendations class="recommendation-list"></ol><p class="route-prerequisite">개념이 낯설다면 <a href="/book/ch01/#chapter-brief">1장의 핵심 판단</a>에서 시작하세요. 추천은 읽을 순서를 돕는 안내이며 전체 목차는 언제든 열 수 있습니다.</p><div class="action-row"><button type="button" data-edit-answers class="secondary-button">답변 바꾸기</button><a data-full-book href="/contents/">전체 20장 읽기</a><button type="button" data-clear-answers class="quiet-button">추천 답변 초기화</button></div></section>
 </div>
 <script src="../scripts/quiz.ts"></script>
</StarlightPage>
